# Loader: access sequences (loader/accesses.rs)

class Accesses:
    @staticmethod
    def corpus_function(address: int, context: int, length: int, counts: list[int], *, owner: object = None) -> Accesses: ...
    def slice(self, start: int = 0, count: int | None = None) -> Accesses: ...
    @staticmethod
    def shuffle(cells: int, epochs: int, seed: int = 0, block: int = 1, group: int = 1) -> Accesses: ...
    @staticmethod
    def subset(cells: np.ndarray, epochs: int, seed: int = 0, block: int = 1, group: int = 1) -> Accesses: ...
    @staticmethod
    def function(address: int, context: int, length: int, *, owner: object = None) -> Accesses: ...
    @staticmethod
    def array(cells: np.ndarray) -> Accesses: ...
    @staticmethod
    def replicate(positions: np.ndarray | Accesses, schemas: int) -> Accesses: ...
    @staticmethod
    def offset(positions: np.ndarray | Accesses, offsets: list[int]) -> Accesses: ...
    def __len__(self) -> int: ...
    def fill(self, start: int = 0, count: int | None = None, *, out: np.ndarray | None = None) -> np.ndarray: ...

