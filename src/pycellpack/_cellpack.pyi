# Storage (store.rs)

class GeneMap:
    def __init__(self, targets: Any, n_genes: int | None = None) -> None: ...
    @property
    def n_genes(self) -> int: ...
    @property
    def targets(self) -> np.ndarray: ...
    @property
    def is_identity(self) -> bool: ...
    def __len__(self) -> int: ...
    def __array__(self, dtype: Any = None, copy: bool | None = None) -> np.ndarray: ...

class File:
    def __init__(
        self, path: str | PathLike[str], offset: int = 0, length: int | None = None
    ) -> None: ...
    @property
    def identity(self) -> tuple[int, int]: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def dtype(self) -> str: ...
    @property
    def format(self) -> str: ...
    @property
    def page_size(self) -> int: ...
    def prepare_read(
        self,
        rows: tuple[int, int] | np.ndarray,
        gene_map: GeneMap | None = None,
        options: dict[str, Any] | None = None,
    ) -> ReadSelection: ...
    def chunk_info(self) -> list[tuple[int, int, int, int, int]]: ...
    @property
    def n_chunks(self) -> int: ...
    def chunk_info_one(self, chunk: int) -> tuple[int, int, int, int, int]: ...
    def read_chunk_into(self, chunk: int, out: np.ndarray, metadata: bool) -> None: ...

class ReadWorkspace:
    def __init__(self) -> None: ...
    def clear(self) -> None: ...

class ReadSelection:
    def io_summary(self) -> dict[str, int]: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def dtype(self) -> str: ...
    @property
    def capacity_nnz(self) -> int: ...
    def read_dense_into(
        self, out: np.ndarray, workspace: ReadWorkspace | None = None, workers: int = 1
    ) -> None: ...
    def read_csr_into(
        self,
        indptr: np.ndarray,
        indices: np.ndarray,
        data: np.ndarray,
        workspace: ReadWorkspace | None = None,
        workers: int = 1,
    ) -> int: ...

class Writer:
    def __init__(
        self,
        path: str | PathLike[str],
        n_cols: int,
        dtype: str,
        format: str = "csr",
        chunk_rows: int = 4096,
        page_size: int = 4096,
        options: dict[str, Any] | None = None,
        threads: int = 1,
    ) -> None: ...
    def append_dense(self, data: np.ndarray) -> None: ...
    def append_csr(
        self, indptr: np.ndarray, indices: np.ndarray, data: np.ndarray
    ) -> None: ...
    def end_chunk(self) -> None: ...
    def finish(self) -> None: ...
    def abort(self) -> None: ...

