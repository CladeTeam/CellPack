        self, rows: tuple[int, int] | np.ndarray | None
    ) -> tuple[int, int]: ...
    def copy_modes(self, out: np.ndarray) -> bool: ...

class ScansEncodeTables:
    def __init__(self, meta: ScansMeta) -> None: ...
    def check(self, meta: ScansMeta) -> None: ...
    def gene_map(self, out: np.ndarray) -> bool: ...

class ScansDecodeTables:
    def __init__(self, meta: ScansMeta) -> None: ...
    def check(self, meta: ScansMeta) -> None: ...
    def gene_maps(self, source: np.ndarray, coded: np.ndarray) -> bool: ...
    def compose(self, gene_map: GeneMap) -> GeneMap: ...
    def decode_dense_into(
        self,
        meta: ScansMeta,
        records: np.ndarray,
        rows: tuple[int, int] | np.ndarray | None,
        out: np.ndarray,
        workspace: np.ndarray,
        coded: bool,
        zero: bool,
        workers: int = 1,
    ) -> None: ...
    def decode_csr_into(
        self,
        meta: ScansMeta,
        records: np.ndarray,
        rows: tuple[int, int] | np.ndarray | None,
        indptr: np.ndarray,
        indices: np.ndarray,
        values: np.ndarray,
        workspace: np.ndarray,
        coded: bool,
        workers: int = 1,
    ) -> int: ...
    def decode_record_into(
        self,
        meta: ScansMeta,
        record: np.ndarray,
        indices: np.ndarray | None,
        values: np.ndarray,
        workspace: np.ndarray,
        coded: bool,
        zero: bool,
    ) -> int: ...
    def decode_pages_into(
        self,
        meta: ScansMeta,
        pages: list[np.ndarray],
        page_size: int,
        start: int,
        length: int,
        indices: np.ndarray | None,
        values: np.ndarray,
        workspace: np.ndarray,
        coded: bool,
        zero: bool,
    ) -> int: ...

