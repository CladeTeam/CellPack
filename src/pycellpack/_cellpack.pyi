class ProcessFn:
    def __init__(self, capsule: Any, identity: int, owner: Any = None, partial_rows: bool = False, row_format: str = "auto") -> None: ...
    @property
    def addresses(self) -> tuple[int, int]: ...

# Loader: rings, batches and consumers (loader/ring.rs)

class RingLayout:
    def __init__(self, slots: int, slot_rows: int, outputs: list[tuple[str, Any, int]], world: int = 1) -> None: ...
    @property
    def slots(self) -> int: ...
    @property
    def slot_rows(self) -> int: ...
    @property
    def world(self) -> int: ...
    @property
    def names(self) -> list[str]: ...
    @property
    def outputs(self) -> list[tuple[str, str | None, int]]: ...
    @property
    def row_bytes(self) -> list[int]: ...
    @property
    def control_bytes(self) -> int: ...
    @property
    def data_bytes(self) -> int: ...
    @property
    def data_min_bytes(self) -> int: ...
    @property
    def offsets(self) -> list[int]: ...
    @property
    def slot_stride(self) -> int: ...

class Ring:
    def __init__(self, layout: RingLayout, *, data: np.ndarray | None = None, control: np.ndarray | None = None, initialize: bool = True) -> None: ...
    @property
    def layout(self) -> RingLayout: ...
    @property
    def slots(self) -> int: ...
    @property
    def world(self) -> int: ...
    @property
    def shared(self) -> bool: ...
    @property
    def generation(self) -> int: ...
    def abort(self) -> None: ...
    def consumer(self, rank: int = 0, *, idle: Callable[[], object] | None = None, watch_producer: bool = True) -> Consumer: ...

class Batch:
    @property
    def index(self) -> int: ...
    @property
    def first_position(self) -> int: ...
    @property
    def rows(self) -> int: ...
    @property
    def generation(self) -> int: ...
    @property
    def names(self) -> list[str]: ...
    def keys(self) -> list[str]: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def __contains__(self, name: str) -> bool: ...
    def __getitem__(self, key: str | int) -> np.ndarray: ...
    def region(self, key: str | int) -> np.ndarray: ...
    def arrays(self) -> dict[str, np.ndarray]: ...
    @property
    def data(self) -> np.ndarray: ...
    def release(self) -> None: ...
    @property
    def held(self) -> bool: ...
    def observer(self) -> LeaseObserver: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> bool: ...

class LeaseObserver:
    @property
    def held(self) -> bool: ...

class Consumer:
    @property
    def rank(self) -> int: ...
    @property
    def next_batch(self) -> int: ...
    @property
    def finished(self) -> bool: ...
    def __iter__(self) -> Consumer: ...
    def __next__(self) -> Batch: ...
    def wait(self, batch: int) -> Batch | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> bool: ...

# Loader: loader and runs (loader/loader.rs, loader/run.rs, loader/stats.rs)

class Loader:
    def __init__(self, source: DataSource, schemas: list[OutputSchema], config: Any) -> None: ...
    @property
    def window(self) -> int: ...
    @property
    def accesses_per_slot(self) -> int: ...
    @property
    def cores(self) -> float: ...
    def memory_estimate(self, slots: int, world: int, *, plan: Plan | None = None, options: Any = None, cache_bytes: int = 0) -> dict[str, int]: ...
    def compile(self, accesses: np.ndarray | Accesses, options: Any, *, online: bool = False) -> tuple[Plan, dict[str, Any] | None]: ...
    def compile_stats(self, accesses: np.ndarray | Accesses, options: Any) -> dict[str, Any]: ...
    def replay(self, plan: Plan, accesses: np.ndarray | Accesses, *, cost: Any = None) -> dict[str, Any]: ...
    def start(self, accesses: np.ndarray | Accesses, ring: Ring, *, rank: int = 0, plan: Plan | None = None, options: Any = None) -> Run: ...

class Run:
    @property
    def generation(self) -> int: ...
    @property
    def batches(self) -> int: ...
    @property
    def ring(self) -> Ring: ...
    @property
    def rank(self) -> int: ...
    @property
    def world(self) -> int: ...
    @property
    def finished(self) -> bool: ...
    @property
    def succeeded(self) -> bool: ...
    def cancel(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> bool: ...
    def __iter__(self) -> Run: ...
    def __next__(self) -> Batch: ...
    def wait(self, batch: int) -> Batch | None: ...
    def consumer(self, rank: int, *, idle: Callable[[], object] | None = None) -> Consumer: ...
    def wait_finished(self, timeout_ms: int = 50) -> bool: ...
    def snapshot(self) -> RunStats: ...
    def join(self) -> RunStats: ...

def register_run_stats(factory: Callable[[dict[str, Any]], Any]) -> None: ...

# Plans and costs (opt/)

class Plan:
    @staticmethod
    def open(path: str | os.PathLike[str]) -> Plan: ...
    def write(self, path: str | os.PathLike[str]) -> None: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> Plan: ...
    @property
    def summary(self) -> dict[str, Any]: ...
    @property
    def distance(self) -> int: ...
    @property
    def schemas(self) -> int: ...
    @property
    def slot_rows(self) -> int: ...
    @property
    def reuse_gap(self) -> int: ...
    @property
    def cache_bytes(self) -> int: ...
    @property
    def cache_frames(self) -> int: ...
    def __len__(self) -> int: ...
    def residencies(self) -> dict[str, np.ndarray]: ...

class PageTrace:
    def __init__(self, pages: np.ndarray, universe: int) -> None: ...
    @staticmethod
    def from_source(source: DataSource, accesses: np.ndarray | Accesses) -> PageTrace: ...
    @property
    def page_uses(self) -> int: ...
    @property
    def distinct_pages(self) -> int: ...
    def optimum(self, capacity_pages: int) -> dict[str, int]: ...

def access_fingerprint(accesses: np.ndarray) -> int: ...

def cost_defaults() -> dict[str, Any]: ...
